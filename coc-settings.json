{
  "snippets.ultisnips.pythonPrompt": false,
  "markdownlint.config": {
    "MD022": false,
    "MD013": false,
    "MD007":false
  },
  "workspace.openResourceCommand": "drop",
  "languageserver": {
    "cobol-lsp": {
      "command": "java",
      "args": ["-jar", "/home/wallace_dev/.local/share/cobol-lsp/server.jar"],
      "filetypes": ["cobol", "cbl", "cpy"],
      "rootPatterns": [".cobolplugin/", ".git/"],
      "settings": {
        "cobol-lsp": {
          "analysis-mode": "BASIC",
          "logging.level.root": "ERROR"
        }
      }
    }
  },
  "notification.disabledProgressSources": ["*"],
  "diagnostic.virtualText": false,
  "diagnostic.messageTimeout": 0
}
